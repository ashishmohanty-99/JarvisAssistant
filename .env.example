# Voice (required for `sidekick voice`, `transcribe`, `say`)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2

# Jobs (optional: Adzuna covers India; the other sources need no key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Adzuna covers India and the Netherlands but not Japan; for Japan add employers' Greenhouse/Lever boards.
SIDEKICK_COUNTRIES=in,nl
SIDEKICK_LOCATIONS="India, Netherlands, Japan, remote"
SIDEKICK_RESUME=

# Your time zone, for "Good morning / evening" (IANA name)
SIDEKICK_TIMEZONE=Asia/Kolkata

# How the bot addresses you when you call it by name ("Jarvis, ..."). Default: Master
SIDEKICK_TITLE=

# Your own YouTube channel id (UC...), for `sidekick channel` and /channel
SIDEKICK_YOUTUBE_CHANNEL=

# Telegram: briefing delivery and the private bot (`sidekick bot`).
# TELEGRAM_CHAT_ID is YOUR numeric id (message @userinfobot). The bot answers nobody else.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
